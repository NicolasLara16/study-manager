# Exemplo de variáveis de ambiente — copie para `.env.local` e preencha com valores reais.
# NUNCA commitar `.env`, `.env.local` ou variações (ver .gitignore).

# --- Públicos (browser + server) -------------------------------------------
# Nota: todo NEXT_PUBLIC_* é público por definição — NUNCA coloque segredo nesses nomes.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# CHAVE PREFERIDA (novo padrão do Supabase, formato sb_publishable_...):
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# FALLBACK LEGADO (aceito somente se PUBLISHABLE_KEY não estiver definida):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi... (role anon)

# ATENÇÃO: chaves secretas (sb_secret_... ou JWT com role service_role) em
# qualquer NEXT_PUBLIC_* são REJEITADAS com erro — o valor ficaria visível no
# bundle do browser. Segredo vai apenas em variável de servidor, abaixo.

# --- Somente servidor -------------------------------------------------------
# Conexão do Prisma (pooled). Nunca exponha ao client.
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres?sslmode=require&pgbouncer=true

# Conexão direta (sem pool) usada apenas em migrations.
DIRECT_URL=postgresql://usuario:senha@host:5432/postgres?sslmode=require

# Opcional: BYPASSA RLS — usar apenas em módulos admin server-only (ex.: purge de Storage).
# SUPABASE_SERVICE_ROLE_KEY=service-role-key
