// ============================================================
// study-manager — schema v1 (Backend E1)
// Base: docs/fase2-relatorio-adm-eng.md §3 (prevalece sobre docs/fase2-modelagem-dados-oplogica.md)
//
// Decisões-chave:
// - Sem tabela User: o e-mail vive em auth.users (Supabase). Profile.id = auth uid (sem default —
//   o id é sempre o id da sessão, escrito por ensureProfile()/trigger de migração).
// - Todas as durações em SEGUNDOS (calcadas nas sessões e settings); blocos planejados em minutos.
// - userId desnormalizado em Discipline/Topic para filtro direto e políticas RLS.
// - Exclusão de estrutura não apaga histórico: FKs de medição usam SetNull + snapshots de nome.
// - Constraints não expressáveis no Prisma (índice parcial de sessão ativa, CHECKs) e RLS
//   estão em prisma/sql/001_constraints_rls.sql (anexar à migration inicial; não executar aqui).
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------------ enums

enum GoalStatus {
  active
  archived

  @@map("goal_status")
}

enum SessionMode {
  free
  pomodoro

  @@map("session_mode")
}

enum SessionStatus {
  in_progress
  paused
  completed
  cancelled

  @@map("session_status")
}

enum PlannedBlockStatus {
  pending
  done
  missed

  @@map("planned_block_status")
}

enum LibraryStatus {
  not_started
  in_progress
  done

  @@map("library_status")
}

enum MaterialType {
  video
  article
  pdf
  course

  @@map("material_type")
}

enum MaterialLevel {
  beginner
  intermediate
  advanced

  @@map("material_level")
}

enum BreakType {
  short
  long

  @@map("break_type")
}

enum ThemeChoice {
  light
  dark
  system

  @@map("theme_choice")
}

// ------------------------------------------------------------------ identity

model Profile {
  id               String    @id @db.Uuid /// id = auth.users.id (Supabase); sem default
  name             String
  avatarUrl        String?
  termsAcceptedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  settings             UserSettings?
  goals                Goal[]
  disciplines          Discipline[]
  topics               Topic[]
  weeklyGoals          WeeklyGoal[]
  disciplineWeeklyGoals DisciplineWeeklyGoal[]
  plannedBlocks        PlannedBlock[]
  sessions             StudySession[]
  savedMaterials       SavedMaterial[]
  ownedMaterials       Material[]

  @@map("profiles")
}

model UserSettings {
  userId                 String      @id @db.Uuid
  timezone               String      @default("America/Sao_Paulo") @db.VarChar(64)
  weeklyTargetMinutes    Int         @default(600)
  dailyTargetMinutes     Int?
  pomodoroFocusSec       Int         @default(1500)
  pomodoroShortBreakSec  Int         @default(300)
  pomodoroLongBreakSec   Int         @default(900)
  cyclesBeforeLongBreak  Int         @default(4)
  notifySessionReminders Boolean     @default(true)
  timerSounds            Boolean     @default(true)
  theme                  ThemeChoice @default(system)
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// ------------------------------------------------------------------ goals

model Goal {
  id                  String    @id @default(uuid())
  userId              String    @db.Uuid
  title               String    @db.VarChar(200)
  description         String?
  color               String    @default("#4F46E5") @db.VarChar(7)
  status              GoalStatus @default(active)
  targetDate          DateTime? @db.Date
  weeklyTargetMinutes Int?
  archivedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  profile    Profile    @relation(fields: [userId], references: [id], onDelete: Cascade)
  disciplines Discipline[]
  sessions   StudySession[]
  blocks     PlannedBlock[]
  weeklyGoals WeeklyGoal[]

  @@index([userId, status])
  @@map("goals")
}

model Discipline {
  id         String    @id @default(uuid())
  goalId     String
  userId     String    @db.Uuid
  name       String    @db.VarChar(200)
  position   Int       @default(0)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  topics             Topic[]
  weeklyGoals        DisciplineWeeklyGoal[]
  sessions           StudySession[]
  blocks             PlannedBlock[]

  @@unique([goalId, name])
  @@index([userId])
  @@map("disciplines")
}

model Topic {
  id           String   @id @default(uuid())
  disciplineId String
  userId       String   @db.Uuid
  name         String   @db.VarChar(200)
  position     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  discipline Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  profile     Profile    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions StudySession[]
  blocks   PlannedBlock[]

  @@unique([disciplineId, name])
  @@index([userId])
  @@map("topics")
}

// ------------------------------------------------------------------ planning

model WeeklyGoal {
  id            String   @id @default(uuid())
  userId        String   @db.Uuid
  goalId        String?
  weekStart     DateTime @db.Date
  targetMinutes Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal    Goal?   @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@unique([userId, weekStart, goalId])
  @@index([userId, weekStart])
  @@map("weekly_goals")
}

model DisciplineWeeklyGoal {
  id           String   @id @default(uuid())
  userId       String   @db.Uuid
  disciplineId String
  weekStart    DateTime @db.Date
  targetMinutes Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile    Profile    @relation(fields: [userId], references: [id], onDelete: Cascade)
  discipline Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)

  @@unique([userId, disciplineId, weekStart])
  @@index([userId, weekStart])
  @@map("discipline_weekly_goals")
}

model PlannedBlock {
  id           String             @id @default(uuid())
  userId       String             @db.Uuid
  weekStart    DateTime           @db.Date
  dayOfWeek    Int /// 0 = segunda ... 6 = domingo
  startTime    String             @db.VarChar(5) /// "HH:mm"
  durationMin  Int
  status       PlannedBlockStatus @default(pending)
  goalId       String?
  disciplineId String?
  topicId      String?
  label        String?            @db.VarChar(200) /// bloco ad-hoc (ex.: "Simulado") sem FK
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  profile    Profile     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal       Goal?       @relation(fields: [goalId], references: [id], onDelete: SetNull)
  discipline Discipline? @relation(fields: [disciplineId], references: [id], onDelete: SetNull)
  topic      Topic?      @relation(fields: [topicId], references: [id], onDelete: SetNull)
  sessions   StudySession[]

  @@index([userId, weekStart, dayOfWeek, startTime])
  @@map("planned_blocks")
}

// ------------------------------------------------------------------ sessions

model StudySession {
  id            String        @id @default(uuid())
  userId        String        @db.Uuid
  goalId        String?
  disciplineId  String?
  topicId       String?
  plannedBlockId String?
  goalTitleSnap        String? @db.VarChar(200)
  disciplineNameSnap   String? @db.VarChar(200)
  topicNameSnap        String? @db.VarChar(200)
  mode          SessionMode
  status        SessionStatus @default(in_progress)
  startedAt     DateTime
  endedAt       DateTime?
  durationSec   Int           @default(0) /// tempo efetivo de FOCO em segundos
  pausedSec     Int           @default(0) /// pausas manuais (modo livre), fora do tempo efetivo
  pomodoroCycles Int          @default(0)
  cyclesTarget   Int          @default(4)
  notes         String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  profile    Profile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal       Goal?          @relation(fields: [goalId], references: [id], onDelete: SetNull)
  discipline Discipline?    @relation(fields: [disciplineId], references: [id], onDelete: SetNull)
  topic      Topic?         @relation(fields: [topicId], references: [id], onDelete: SetNull)
  block      PlannedBlock?  @relation(fields: [plannedBlockId], references: [id], onDelete: SetNull)
  breaks     SessionBreak[]

  @@index([userId, startedAt(sort: Desc)])
  @@index([userId, disciplineId, startedAt])
  @@index([plannedBlockId])
  @@map("study_sessions")
}

model SessionBreak {
  id          String    @id @default(uuid())
  sessionId   String
  type        BreakType
  startedAt   DateTime
  endedAt     DateTime?
  durationSec Int

  session StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("session_breaks")
}

// ------------------------------------------------------------------ library

model Material {
  id          String        @id @default(uuid())
  ownerId     String?       @db.Uuid /// null = catálogo global (Explorar)
  source      String        @db.VarChar(120)
  externalId  String?       @db.VarChar(255)
  url         String        @db.VarChar(1000)
  title       String        @db.VarChar(300)
  description String?       @db.Text
  type        MaterialType
  level       MaterialLevel?
  language    String?       @db.VarChar(10)
  minutes     Int?
  rating      Float?
  verified    Boolean       @default(false)
  tags        String[]      @default([])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  owner  Profile?        @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  savedBy SavedMaterial[]

  @@unique([source, externalId])
  @@index([type])
  @@map("materials")
}

model SavedMaterial {
  id             String        @id @default(uuid())
  userId         String        @db.Uuid
  materialId     String
  status         LibraryStatus @default(not_started)
  progress       Int           @default(0) /// 0..100; concluido ⇔ 100
  favorite       Boolean       @default(false)
  savedAt        DateTime      @default(now())
  lastProgressAt DateTime?
  completedAt    DateTime?

  profile  Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@unique([userId, materialId])
  @@index([userId, status])
  @@index([userId, favorite])
  @@map("saved_materials")
}
